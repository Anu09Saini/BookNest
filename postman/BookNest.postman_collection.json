  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Get book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            }
          }
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Write operation. Use a unique ISBN each time.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"BookNest Postman Sample\",\n  \"isbn\": \"BN-POSTMAN-2026-001\",\n  \"publication_year\": 2026\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Member",
      "item": [
        {
          "name": "Register member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/members/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "members"
              ]
            },
            "description": "Creates a member. Change email if already registered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Member\",\n  \"email\": \"postman-member@example.com\",\n  \"password\": \"ReplaceThisPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Member login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/member/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "member",
                "login"
              ]
            },
            "description": "Copy access_token from response into member_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current member",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{member_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/members/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "members",
                "me"
              ]
            }
          }
        },
        {
          "name": "My loans",
          "request": {
            "method": "GET",
            "header": [
              {
