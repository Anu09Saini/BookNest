            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": {{member_id}},\n  \"copy_id\": {{copy_id}},\n  \"due_date\": \"{{due_date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
