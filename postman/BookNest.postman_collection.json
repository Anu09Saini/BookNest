                "value": "Bearer {{member_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/members/me/fines",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "members",
                "me",
                "fines"
              ]
            }
          }
        },
        {
          "name": "Pay a fine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{member_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fines/{{fine_id}}/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fines",
                "{{fine_id}}",
                "payments"
              ]
            },
            "description": "Use a fine owned by this member. Amount must not exceed outstanding balance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{payment_amount}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
